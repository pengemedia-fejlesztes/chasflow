{
  "name": "cashflow-tervezo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node tools/package-mac.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "audit:security": "npm audit --audit-level=moderate",
    "format": "prettier --write worker shared web/src tests",
    "worker:dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply cashflow --local",
    "db:migrate:remote": "wrangler d1 migrations apply cashflow --remote",
    "deploy": "echo 'Élesítés: push a GitHubra (claude/dreamy-johnson-9ejay9) – a GitHub Actions a pmdev.hu/Cashflow-ra telepít.' && exit 1",
    "build:server": "esbuild worker/index.ts --bundle --format=esm --platform=node --target=node22 --outfile=dist-worker/worker.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "mysql2": "^3.24.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
