{
  "name": "cashflow-tervezo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write worker shared web/src tests",
    "worker:dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply cashflow --local",
    "db:migrate:remote": "wrangler d1 migrations apply cashflow --remote",
    "deploy": "npm run build && wrangler d1 migrations apply cashflow --remote && wrangler deploy"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.149.0"
  }
}
