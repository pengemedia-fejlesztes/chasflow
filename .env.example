# Lokalis futtatas beallitasai – masold le .env neven (a .env NEM kerul a gitbe).
# Mindegyik opcionalis: nelkuluk az app elindul, csak az adott kulso kapcsolat nem mukodik.

# Az elso admin letrehozasahoz kert kod (alapbol: helyi-teszt)
SETUP_TOKEN=helyi-teszt

# Billingo v3 API kulcs (lokalisan inkabb egy teszt-fiokhoz tartozot hasznalj)
# BILLINGO_API_KEY=

# NAV Online Szamla technikai felhasznalo
# NAV_LOGIN=
# NAV_PASSWORD=
# NAV_SIGN_KEY=
# NAV_EXCHANGE_KEY=
# NAV_TAX_NUMBER=

# Enable Banking (PSD2)
# EB_APP_ID=
# EB_PRIVATE_KEY=

# E-mail kuldes (elfelejtett jelszo)
# BREVO_API_KEY=
# MAIL_FROM=
